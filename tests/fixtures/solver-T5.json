 "clauses": {
  "C1": {
   "title": "Leverage covenant after cure",
   "waivable": false,
   "sources": [
    {
     "source_document": "documents/loan-policy.txt",
     "quote": "Leverage is gross debt divided by trailing twelve-month EBITDA, maximum 3.00."
    },
    {
     "source_document": "documents/cure-policy.txt",
     "quote": "Asset sales: net proceeds of a permitted asset sale must repay debt, and the EBITDA and cash flow of the asset sold are removed from the trailing twelve-month figures."
    }
   ]
  },
  "C2": {
   "title": "DSCR covenant after cure",
   "waivable": true,
   "sources": [
    {
     "source_document": "documents/loan-policy.txt",
     "quote": "DSCR is trailing twelve-month available cash flow divided by trailing twelve-month debt service, minimum 1.20."
    },
    {
     "source_document": "documents/cure-policy.txt",
     "quote": "Prepayment: a voluntary prepayment pays the stated premium and reduces trailing twelve-month debt service by the stated amount per dollar repaid."
    }
   ]
  },
  "C3": {
   "title": "Equity cure cap",
   "waivable": false,
   "sources": [
    {
     "source_document": "documents/cure-policy.txt",
     "quote": "Equity cure: the sponsor may contribute cash that is added to EBITDA and to available cash flow for the quarter tested, up to the equity cure cap in cure_terms.csv."
    }
   ]
  },
  "C4": {
   "title": "Cure frequency",
   "waivable": false,
   "sources": [
    {
     "source_document": "documents/cure-policy.txt",
     "quote": "Cure frequency: an equity cure may be used only while cures remaining in the last four fiscal quarters is at least 1."
    }
   ]
  },
  "C5": {
   "title": "Minimum liquidity after prepayment",
   "waivable": false,
   "sources": [
    {
     "source_document": "documents/cure-policy.txt",
     "quote": "Minimum liquidity: after any voluntary prepayment the borrower must keep cash of at least the minimum liquidity in cure_terms.csv."
    }
   ]
  },
  "C6": {
   "title": "Current ratio after cure",
   "waivable": false,
   "sources": [
    {
     "source_document": "team/covenant-policy-addendum.txt",
     "quote": "Current Ratio is current assets divided by current liabilities at quarter end, minimum 1.25."
    },
    {
     "source_document": "documents/cure-policy.txt",
     "quote": "Cure cash: a voluntary prepayment and its premium are paid from cash and reduce current assets, equity cure cash is not added to current assets, and the sale cost of a permitted asset sale is paid from its gross proceeds."
    }
   ]
  }
 },
